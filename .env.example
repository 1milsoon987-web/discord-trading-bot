# Discord (choose ONE of the two modes below)
# Bot mode (persistent connection - needed only for the deprecated `python -m bot.main` hosted setup):
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_SIGNAL_CHANNEL_ID=123456789012345678
# Webhook mode (used by `python -m bot.main --webhook` and the GitHub Actions workflow):
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/.../...

# Data Providers
TWELVEDATA_API_KEY=your_twelvedata_key_here
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Optional news
NEWS_API_KEY=

# Behavior
TIMEZONE=Africa/Casablanca
DAILY_REPORT_HOUR=7
DAILY_REPORT_MINUTE=0

# Risk
DEFAULT_RISK_PERCENT=1.0
MIN_CONFIDENCE_SCORE=65

# Logging
LOG_LEVEL=INFO

# Dev
DRY_RUN=false
